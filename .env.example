# Configuración del servidor
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Claude API (Anthropic)
ANTHROPIC_API_KEY=tu-api-key-aqui

# OpenAI API (para embeddings)
OPENAI_API_KEY=tu-openai-api-key-aqui

# Supabase
SUPABASE_URL=tu-supabase-url-aqui
SUPABASE_KEY=tu-supabase-key-aqui

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Encriptación de documentos (opcional pero recomendado)
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=tu-clave-secreta-aqui

# Autenticación
ADMIN_USERNAME=admin
# Hash PBKDF2 (formato salt$hash). Generalo con hash_password() en app/api/auth.py.
ADMIN_PASSWORD_HASH=tu-hash-aqui
SESSION_SECRET=una-clave-larga-y-aleatoria

# Resend (envío de mails de reportes). Sin esto, el envío queda deshabilitado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nombre del bot <tu-remitente@tudominio.com>

# Google Drive (respaldo de reportes). Sin ambas, el respaldo queda deshabilitado.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Límite de mensajes diarios por usuario (0 = ilimitado)
DAILY_MESSAGE_LIMIT=0

# Cache de respuestas (0 = deshabilitado)
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500
